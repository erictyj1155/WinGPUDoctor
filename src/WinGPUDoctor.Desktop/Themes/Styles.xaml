<!-- Shared styles (docs/GUI_PLAN.md, "Visual design"). Colors come only from the active palette
     (Palette.*.xaml) through DynamicResource, so a Windows theme change restyles the whole window.
     Fonts are Windows built-ins; no font file is bundled. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WinGPUDoctor.Desktop.Views">
  <BooleanToVisibilityConverter x:Key="Visible" />

  <FontFamily x:Key="Wgd.BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Wgd.DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Wgd.MonoFont">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- Keyboard focus ring; WPF shows it for keyboard navigation only. -->
  <Style x:Key="Wgd.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" BorderThickness="2" CornerRadius="6" BorderBrush="{DynamicResource Wgd.Focus}"
                  SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text -->
  <Style x:Key="Wgd.Eyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Wgd.MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Accent}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style x:Key="Wgd.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Wgd.DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="620" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="Wgd.Lead" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="MaxWidth" Value="560" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="Wgd.Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Wgd.Small" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Wgd.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Wgd.MonoFont}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Wgd.Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Accent}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,2,10,0" />
  </Style>

  <!-- Buttons -->
  <Style x:Key="Wgd.PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Wgd.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.OnAccent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Wgd.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wgd.AccentHover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wgd.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Wgd.GhostButton" TargetType="Button" BasedOn="{StaticResource Wgd.PrimaryButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.Line}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wgd.Hover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Wgd.Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Choice controls -->
  <Style x:Key="Wgd.Radio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,20,6" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Wgd.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource Wgd.Muted}" StrokeThickness="1.5" />
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Wgd.Accent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Wgd.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Wgd.Accent}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Wgd.Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Wgd.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" BorderThickness="1.5" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource Wgd.Muted}" Background="Transparent">
              <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                         Foreground="{DynamicResource Wgd.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Wgd.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wgd.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Wgd.Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- (i) tips: behavior is in Views/InfoTip.cs; this sets only the look. -->
  <Style TargetType="views:InfoTip">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Cursor" Value="Help" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Wgd.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="views:InfoTip">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wgd.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Wgd.Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Wgd.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Wgd.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Wgd.ToolTip" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Wgd.Tip}" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.TipText}" />
    <Setter Property="FontFamily" Value="{StaticResource Wgd.BodyFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  BorderBrush="{DynamicResource Wgd.Line}" BorderThickness="1">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The exact report text: read-only, monospace, scrolls inside its panel. -->
  <Style x:Key="Wgd.PreviewBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Wgd.Preview}" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.PreviewText}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource Wgd.MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Wgd.Accent}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Wgd.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Wgd.Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Wgd.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Wgd.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <!-- Two-column pages (Views/SplitPanel.cs): primary content left, a panel on the right or below. -->
  <Style x:Key="Wgd.MainColumn" TargetType="StackPanel">
    <Setter Property="Margin" Value="36,32,32,32" />
  </Style>
  <Style x:Key="Wgd.SideColumn" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Wgd.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.Line}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="28,32,32,28" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsStacked, RelativeSource={RelativeSource AncestorType=views:SplitPanel}}" Value="True">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="36,24,32,28" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Wgd.Readout" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style x:Key="Wgd.ReadoutHeader" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.Line}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style x:Key="Wgd.ReadoutLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
    <Setter Property="Margin" Value="0,5,12,5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="Wgd.ReadoutValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Wgd.MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Indeterminate scan progress (Views/Motion.cs); steady when Windows animations are off. -->
  <Style x:Key="Wgd.ScanProgress" TargetType="ProgressBar">
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Height" Value="3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <views:SweepBar Track="{DynamicResource Wgd.Line}" Glow="{DynamicResource Wgd.Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Wgd.Warn" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Wgd.AccentTint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Wgd.AccentEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
</ResourceDictionary>
