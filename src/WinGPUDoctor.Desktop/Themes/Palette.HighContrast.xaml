<!-- High-contrast palette: the same keys mapped to the active Windows contrast theme's system
     colors, so tints and accents give way to the user's chosen colors. Reloaded when they change. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Wgd.Background" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Wgd.Panel" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Wgd.Line" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Wgd.Text" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Wgd.Muted" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Wgd.Accent" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Wgd.AccentHover" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Wgd.OnAccent" Color="{x:Static SystemColors.HighlightTextColor}" />
  <SolidColorBrush x:Key="Wgd.Data" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Wgd.AccentTint" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Wgd.AccentEdge" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Wgd.DataTint" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Wgd.Hover" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Wgd.Preview" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Wgd.PreviewText" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Wgd.Tip" Color="{x:Static SystemColors.InfoColor}" />
  <SolidColorBrush x:Key="Wgd.TipText" Color="{x:Static SystemColors.InfoTextColor}" />
  <SolidColorBrush x:Key="Wgd.Focus" Color="{x:Static SystemColors.WindowTextColor}" />
</ResourceDictionary>
