<!-- Dark palette (direction B, "diagnostic instrument panel"). Every UI color lives in the three
     palettes, which define the same keys; XAML refers to these keys only. Contrast is checked by tests. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Wgd.Background" Color="#171C22" />
  <SolidColorBrush x:Key="Wgd.Panel" Color="#1E252D" />
  <SolidColorBrush x:Key="Wgd.Line" Color="#2E3844" />
  <SolidColorBrush x:Key="Wgd.Text" Color="#E4EAF0" />
  <SolidColorBrush x:Key="Wgd.Muted" Color="#8795A3" />
  <!-- Accent is amber text and icons; AccentFill is the amber surface under OnAccent text. -->
  <SolidColorBrush x:Key="Wgd.Accent" Color="#F2A541" />
  <SolidColorBrush x:Key="Wgd.AccentFill" Color="#F2A541" />
  <SolidColorBrush x:Key="Wgd.AccentHover" Color="#F5B561" />
  <SolidColorBrush x:Key="Wgd.OnAccent" Color="#1A1307" />
  <SolidColorBrush x:Key="Wgd.Data" Color="#7CC4E0" />
  <SolidColorBrush x:Key="Wgd.AccentTint" Color="#10F2A541" />
  <SolidColorBrush x:Key="Wgd.AccentEdge" Color="#73F2A541" />
  <SolidColorBrush x:Key="Wgd.DataTint" Color="#1F7CC4E0" />
  <SolidColorBrush x:Key="Wgd.Hover" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Wgd.Preview" Color="#12171C" />
  <SolidColorBrush x:Key="Wgd.PreviewText" Color="#B9C6D2" />
  <SolidColorBrush x:Key="Wgd.Tip" Color="#F2F4F6" />
  <SolidColorBrush x:Key="Wgd.TipText" Color="#1A2027" />
  <SolidColorBrush x:Key="Wgd.Focus" Color="#E4EAF0" />
</ResourceDictionary>
