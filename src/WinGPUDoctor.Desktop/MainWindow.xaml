<Window x:Class="WinGPUDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinGPUDoctor.Desktop.Views"
        xmlns:vm="clr-namespace:WinGPUDoctor.Desktop.ViewModels"
        Title="{views:Text App.Title}" Width="960" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Wgd.Background}"
        Foreground="{DynamicResource Wgd.Text}" FontFamily="{StaticResource Wgd.BodyFont}" FontSize="14">
  <Window.Resources>
    <!-- The readout's value cells: a dash before a scan, pulsing placeholder lines while reading. -->
    <Style x:Key="ReadoutIdle" TargetType="TextBlock" BasedOn="{StaticResource Wgd.ReadoutValue}">
      <Setter Property="Text" Value="{views:Text Readout.Empty}" />
      <Setter Property="AutomationProperties.Name" Value="{views:Text Readout.NotRead}" />
      <Setter Property="Visibility" Value="{Binding IsWelcome, Converter={StaticResource Visible}}" />
    </Style>
    <Style x:Key="ReadoutPulse" TargetType="views:PulseLine">
      <Setter Property="Fill" Value="{DynamicResource Wgd.Line}" />
      <Setter Property="Margin" Value="0,5" />
      <Setter Property="Visibility" Value="{Binding IsBusy, Converter={StaticResource Visible}}" />
    </Style>
    <Style x:Key="StateGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
      <Setter Property="Margin" Value="0,2,6,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Reported values are data (cyan monospace); unavailable states and descriptions are plain text. -->
    <Style x:Key="FactValue" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="13.5" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsData}" Value="True" />
            <Condition Binding="{Binding IsAvailable}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="FontFamily" Value="{StaticResource Wgd.MonoFont}" />
          <Setter Property="FontSize" Value="12.5" />
          <Setter Property="Foreground" Value="{DynamicResource Wgd.Data}" />
          <Setter Property="Margin" Value="0,1,0,0" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource Wgd.Muted}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="FactTemplate" DataType="{x:Type vm:FactLine}">
      <Grid Margin="0,5,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="FactLabel" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock TextWrapping="Wrap" MaxWidth="180" Margin="0,0,14,0" FontSize="13" Foreground="{DynamicResource Wgd.Muted}">
          <Run Text="{Binding Label, Mode=OneWay}" />
          <InlineUIContainer BaselineAlignment="Center">
            <views:InfoTip Text="{Binding Help}" Label="{Binding HelpName}"
                           Visibility="{Binding HasHelp, Converter={StaticResource Visible}}" />
          </InlineUIContainer>
        </TextBlock>
        <DockPanel Grid.Column="1">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StateGlyph}" Style="{StaticResource StateGlyph}" />
          <TextBlock Text="{Binding Value}" Style="{StaticResource FactValue}" />
        </DockPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NoteTemplate">
      <DockPanel Margin="0,6,0,0">
        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Wgd.Muted}"
                   Margin="0,2,8,0" />
        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="LimitTemplate">
      <DockPanel Margin="0,2">
        <TextBlock DockPanel.Dock="Left" Text="&#x2022;" Foreground="{DynamicResource Wgd.Accent}" Margin="2,0,8,0" />
        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13.5" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="ExplanationTemplate" DataType="{x:Type vm:Explanation}">
      <StackPanel Margin="0,12,0,0">
        <TextBlock Text="{Binding Context}" Style="{StaticResource Wgd.Small}"
                   Visibility="{Binding HasContext, Converter={StaticResource Visible}}" />
        <TextBlock TextWrapping="Wrap" FontSize="14">
          <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
          <InlineUIContainer BaselineAlignment="Center">
            <views:InfoTip Text="{Binding Tip}" Label="{Binding TipName}"
                           Visibility="{Binding HasTip, Converter={StaticResource Visible}}" />
          </InlineUIContainer>
        </TextBlock>
        <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="13.5" Margin="0,2,0,0" />
      </StackPanel>
    </DataTemplate>

    <Style x:Key="Provenance" TargetType="TextBlock" BasedOn="{StaticResource Wgd.Small}">
      <Setter Property="FontSize" Value="12" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Provenance}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="TechnicalTemplate" DataType="{x:Type vm:TechnicalLine}">
      <StackPanel Margin="0,8,0,0">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Wgd.Small}" FontSize="12" />
        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontFamily="{StaticResource Wgd.MonoFont}" FontSize="12.5" />
        <TextBlock Text="{Binding Provenance}" Style="{StaticResource Provenance}" />
      </StackPanel>
    </DataTemplate>

    <!-- Card badge: a Fluent icon on a tint of the card's tone. -->
    <Style x:Key="CardBadge" TargetType="Border">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,12" />
      <Setter Property="Background" Value="{DynamicResource Wgd.DataTint}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Accent">
          <Setter Property="Background" Value="{DynamicResource Wgd.AccentTint}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardBadgeGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Wgd.Data}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tone}" Value="Accent">
          <Setter Property="Foreground" Value="{DynamicResource Wgd.Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Technical details show under every card while the page's single switch is on. -->
    <Style x:Key="TechnicalSection" TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding HasTechnical}" Value="True" />
            <Condition Binding="{Binding DataContext.ShowTechnical, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:CardViewModel}">
      <Border Style="{StaticResource Wgd.Card}">
        <StackPanel>
          <Border Style="{StaticResource CardBadge}" Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource CardBadgeGlyph}" />
          </Border>
          <TextBlock Style="{StaticResource Wgd.Heading}" AutomationProperties.HeadingLevel="Level2">
            <Run Text="{Binding Title, Mode=OneWay}" />
            <InlineUIContainer BaselineAlignment="Center">
              <views:InfoTip Text="{Binding TitleTip}" Label="{Binding TitleTipName}"
                             Visibility="{Binding HasTitleTip, Converter={StaticResource Visible}}" />
            </InlineUIContainer>
          </TextBlock>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Wgd.Small}" Margin="0,2,0,0"
                     Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
          <TextBlock Text="{Binding Say}" FontFamily="{StaticResource Wgd.DisplayFont}" FontSize="18" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,10,0,4" Visibility="{Binding HasSay, Converter={StaticResource Visible}}" />
          <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" Focusable="False"
                        Grid.IsSharedSizeScope="True" Margin="0,4,0,0" />
          <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteTemplate}" Focusable="False" />
          <ItemsControl ItemsSource="{Binding Explanations}" ItemTemplate="{StaticResource ExplanationTemplate}" Focusable="False" />
          <StackPanel Style="{StaticResource TechnicalSection}">
            <Border Height="1" Background="{DynamicResource Wgd.Line}" Margin="0,14,0,2" />
            <ItemsControl ItemsSource="{Binding Technical}" ItemTemplate="{StaticResource TechnicalTemplate}" Focusable="False" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>  </Window.Resources>

  <Grid>
    <!-- Welcome and scanning: direction B. Content and actions on the left; on the right a readout that
         is idle before a scan and shows placeholder lines while Windows is read. -->
    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsWelcome}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <views:SplitPanel MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
          <Grid>
            <StackPanel Style="{StaticResource Wgd.MainColumn}" Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}">
              <TextBlock Text="{views:Text Welcome.Eyebrow}" Style="{StaticResource Wgd.Eyebrow}" />
              <TextBlock Text="{views:Text Welcome.Title}" Style="{StaticResource Wgd.Title}" AutomationProperties.HeadingLevel="Level1" />
              <TextBlock Text="{views:Text Welcome.Intro}" Style="{StaticResource Wgd.Lead}" Margin="0,0,0,24" />
              <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="&#xE890;" Style="{StaticResource Wgd.Glyph}" />
                <TextBlock Text="{views:Text Welcome.PromiseReadOnly}" TextWrapping="Wrap" FontSize="14.5" />
              </DockPanel>
              <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Text="&#xF384;" Style="{StaticResource Wgd.Glyph}" />
                <TextBlock Text="{views:Text Welcome.PromiseNoUpload}" TextWrapping="Wrap" FontSize="14.5" />
              </DockPanel>
              <DockPanel Margin="0,0,0,26">
                <TextBlock DockPanel.Dock="Left" Text="&#xEA18;" Style="{StaticResource Wgd.Glyph}" />
                <TextBlock Text="{views:Text Welcome.PromiseReview}" TextWrapping="Wrap" FontSize="14.5" />
              </DockPanel>
              <Button x:Name="WelcomeScan" Content="{views:Text Welcome.Scan}" Command="{Binding ScanCommand}"
                      Style="{StaticResource Wgd.PrimaryButton}" IsDefault="True" />
            </StackPanel>
            <StackPanel Style="{StaticResource Wgd.MainColumn}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
              <TextBlock Text="{views:Text Scan.Eyebrow}" Style="{StaticResource Wgd.Eyebrow}" />
              <TextBlock Text="{Binding BusyText}" Style="{StaticResource Wgd.Title}" AutomationProperties.HeadingLevel="Level1" />
              <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MaxWidth="440" />
                </Grid.ColumnDefinitions>
                <ProgressBar Style="{StaticResource Wgd.ScanProgress}" AutomationProperties.Name="{Binding BusyText}" />
              </Grid>
              <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource Wgd.Lead}"
                         Visibility="{Binding HasBusyDetail, Converter={StaticResource Visible}}" />
              <Button x:Name="CancelButton" Content="{views:Text Scan.Cancel}" Command="{Binding CancelCommand}"
                      Style="{StaticResource Wgd.GhostButton}" IsCancel="True" Margin="0,24,0,0" />
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Wgd.SideColumn}">
            <StackPanel>
              <Border Style="{StaticResource Wgd.Readout}">
                <StackPanel>
                  <Border Style="{StaticResource Wgd.ReadoutHeader}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Wgd.Caption}">
                            <Setter Property="Text" Value="{views:Text Readout.Idle}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Text" Value="{views:Text Readout.Reading}" />
                                <Setter Property="Foreground" Value="{DynamicResource Wgd.Accent}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsCancelling}" Value="True">
                                <Setter Property="Text" Value="{views:Text Readout.Stopping}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{views:Text Readout.Title}" Style="{StaticResource Wgd.Caption}"
                                 AutomationProperties.HeadingLevel="Level2" />
                    </DockPanel>
                  </Border>
                  <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" MinWidth="120" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{views:Text Readout.System}" Style="{StaticResource Wgd.ReadoutLabel}" />
                    <TextBlock Grid.Row="1" Text="{views:Text Readout.Adapters}" Style="{StaticResource Wgd.ReadoutLabel}" />
                    <TextBlock Grid.Row="2" Text="{views:Text Readout.Drivers}" Style="{StaticResource Wgd.ReadoutLabel}" />
                    <TextBlock Grid.Row="3" Text="{views:Text Readout.Displays}" Style="{StaticResource Wgd.ReadoutLabel}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ReadoutIdle}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Style="{StaticResource ReadoutIdle}" />
                    <TextBlock Grid.Column="1" Grid.Row="2" Style="{StaticResource ReadoutIdle}" />
                    <TextBlock Grid.Column="1" Grid.Row="3" Style="{StaticResource ReadoutIdle}" />
                    <views:PulseLine Grid.Column="1" Fraction="0.7" Style="{StaticResource ReadoutPulse}" />
                    <views:PulseLine Grid.Column="1" Grid.Row="1" Fraction="0.55" Delay="0.15" Style="{StaticResource ReadoutPulse}" />
                    <views:PulseLine Grid.Column="1" Grid.Row="2" Fraction="0.62" Delay="0.3" Style="{StaticResource ReadoutPulse}" />
                    <views:PulseLine Grid.Column="1" Grid.Row="3" Fraction="0.4" Delay="0.45" Style="{StaticResource ReadoutPulse}" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="{views:Text Readout.Note}" Style="{StaticResource Wgd.Small}" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </views:SplitPanel>
      </ScrollViewer>
    </Grid>

    <!-- Results: direction C's guided layout in direction B's colors. The actions stay visible below. -->
    <DockPanel Visibility="{Binding IsViewingResult, Converter={StaticResource Visible}}">
      <Border DockPanel.Dock="Bottom" Style="{StaticResource Wgd.ActionBar}">
        <DockPanel>
          <CheckBox x:Name="TechnicalToggle" DockPanel.Dock="Right" Content="{views:Text Card.ShowTechnical}"
                    IsChecked="{Binding ShowTechnical}" Style="{StaticResource Wgd.Check}" Margin="16,0,0,0" />
          <WrapPanel>
            <Button x:Name="SaveReport" Content="{views:Text Result.SaveReport}" Command="{Binding OpenSaveCommand}"
                    Style="{StaticResource Wgd.PrimaryButton}" Margin="0,0,12,0" />
            <Button x:Name="ResultScan" Content="{views:Text Result.ScanAgain}" Command="{Binding ScanCommand}"
                    Style="{StaticResource Wgd.GhostButton}" />
          </WrapPanel>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="True" AutomationProperties.Name="{views:Text Result.CardsName}">
        <StackPanel DataContext="{Binding Result}" Margin="32,28,32,32" MaxWidth="1200">
          <StackPanel HorizontalAlignment="Center" MaxWidth="700" Margin="0,0,0,24">
            <TextBlock Text="{views:Text Result.Eyebrow}" Style="{StaticResource Wgd.Eyebrow}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource Wgd.Title}" FontSize="28" HorizontalAlignment="Center"
                       TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Wgd.Lead}" HorizontalAlignment="Center" TextAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding MainCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <views:CardGrid MinColumnWidth="260" MaxColumns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding DriverCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False"
                        Margin="0,14,0,0" Visibility="{Binding HasDriverCards, Converter={StaticResource Visible}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <views:CardGrid MinColumnWidth="300" MaxColumns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <Border Style="{StaticResource Wgd.Note}" Margin="0,18,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Wgd.Glyph}" />
              <StackPanel>
                <TextBlock Text="{views:Text Card.Limits.Title}" Style="{StaticResource Wgd.Heading}"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{views:Text Card.Limits.Intro}" TextWrapping="Wrap" FontSize="13.5" Margin="0,4,0,6" />
                <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource LimitTemplate}" Focusable="False">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <views:CardGrid MinColumnWidth="280" MaxColumns="2" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DockPanel>
          </Border>

          <TextBlock Text="{views:Text Result.More}" Style="{StaticResource Wgd.Eyebrow}" Margin="0,28,0,12"
                     AutomationProperties.HeadingLevel="Level2" />
          <ItemsControl ItemsSource="{Binding MoreCards}" ItemTemplate="{StaticResource CardTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <views:CardGrid MinColumnWidth="300" MaxColumns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Review and save: preview and save both come from the retained report -->
    <DockPanel Margin="24,16" DataContext="{Binding Save}"
               Visibility="{Binding DataContext.IsSaving, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
      <!-- The hint, outcome and actions stay visible; the review content and preview scroll above them. -->
      <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
          <TextBlock Text="{views:Text Save.SyncHint}" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Margin="0,8,0,0" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
          <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Text" Value="&#xE73E;" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Text" Value="&#xE7BA;" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock x:Name="SaveStatus" Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="SaveChoose" Content="{views:Text Save.Choose}" Click="OnSaveClick"
                  Style="{StaticResource Wgd.PrimaryButton}" Margin="0,0,12,0" />
          <Button Content="{views:Text Save.Back}" Command="{Binding DataContext.CloseSaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  Style="{StaticResource Wgd.GhostButton}" />
        </StackPanel>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="{views:Text Save.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{views:Text Save.Intro}" TextWrapping="Wrap" Margin="0,4,0,8" />
          <WrapPanel Margin="0,0,0,4">
            <TextBlock Text="{views:Text Save.FormatLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton x:Name="FormatMarkdown" GroupName="Format" Content="{views:Text Save.FormatMarkdown}"
                         IsChecked="{Binding IsMarkdown}" Style="{StaticResource Wgd.Radio}" />
            <RadioButton GroupName="Format" Content="{views:Text Save.FormatJson}" IsChecked="{Binding IsJson}"
                         Style="{StaticResource Wgd.Radio}" />
          </WrapPanel>
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
            <StackPanel>
              <TextBlock Text="{Binding ReviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="{views:Text Save.ContainsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,2"
                     AutomationProperties.HeadingLevel="Level3" />
          <TextBlock Text="{Binding ContentsNote}" TextWrapping="Wrap" Margin="0,0,0,4" />
          <ItemsControl ItemsSource="{Binding Contents}" ItemTemplate="{StaticResource FactTemplate}" Focusable="False" />
          <!-- The exact text that Save writes; clipboard copy is intentionally blocked (GUI plan section 8). -->
          <TextBlock Text="{views:Text Save.PreviewLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"
                     AutomationProperties.HeadingLevel="Level3" />
          <TextBox x:Name="PreviewBox" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Wgd.PreviewBox}"
                   Height="200" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto" ContextMenu="{x:Null}"
                   AutomationProperties.Name="{views:Text Save.PreviewName}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Stopped -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsStopped, Converter={StaticResource Visible}}">
      <StackPanel Style="{StaticResource Wgd.MainColumn}">
        <TextBlock Text="{views:Text Stopped.Eyebrow}" Style="{StaticResource Wgd.Eyebrow}" />
        <TextBlock Text="{views:Text Stopped.Message}" Style="{StaticResource Wgd.Title}" FontSize="26"
                   AutomationProperties.HeadingLevel="Level1" />
        <Button x:Name="StoppedScan" Content="{views:Text Result.ScanAgain}" Command="{Binding ScanCommand}"
                Style="{StaticResource Wgd.PrimaryButton}" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- Restart required -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding NeedsRestart, Converter={StaticResource Visible}}">
      <StackPanel Style="{StaticResource Wgd.MainColumn}">
        <TextBlock Text="{views:Text Restart.Eyebrow}" Style="{StaticResource Wgd.Eyebrow}" />
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Wgd.Glyph}" FontSize="24" Margin="0,4,12,0" />
          <TextBlock Text="{views:Text Restart.Message}" Style="{StaticResource Wgd.Title}" FontSize="26"
                     AutomationProperties.HeadingLevel="Level1" />
        </DockPanel>
        <Button x:Name="RestartClose" Content="{views:Text Restart.Close}" Click="OnCloseClick"
                Style="{StaticResource Wgd.PrimaryButton}" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
