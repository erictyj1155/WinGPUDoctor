<Window x:Class="WinGPUDoctor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinGPUDoctor.Desktop.Views"
        xmlns:vm="clr-namespace:WinGPUDoctor.Desktop.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="{views:Text App.Title}" Width="960" Height="700" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="StateGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="Margin" Value="0,2,6,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="FactTemplate" DataType="{x:Type vm:FactLine}">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="280" />
          <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" Opacity="0.8" />
        <DockPanel Grid.Column="1">
          <TextBlock DockPanel.Dock="Left" Text="{Binding StateGlyph}" Style="{StaticResource StateGlyph}" />
          <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
        </DockPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="NoteTemplate">
      <DockPanel Margin="0,3">
        <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="PromiseTemplate">
      <DockPanel Margin="0,3">
        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
      </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:CardViewModel}">
      <Border Margin="0,0,0,12" Padding="16" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                     AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,0"
                     Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
          <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}"
                        Focusable="False" Margin="0,8,0,0" />
          <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource NoteTemplate}" Focusable="False" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="24,16,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="{views:Text App.Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"
               AutomationProperties.HeadingLevel="Level1" />

    <!-- Welcome -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsWelcome, Converter={StaticResource Visible}}">
      <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{views:Text Welcome.Intro}" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,16" />
        <ItemsControl Focusable="False" Margin="0,0,0,20" ItemTemplate="{StaticResource PromiseTemplate}">
          <ItemsControl.ItemsSource>
            <x:Array Type="{x:Type sys:String}">
              <views:Text Key="Welcome.PromiseReadOnly" />
              <views:Text Key="Welcome.PromiseNoUpload" />
              <views:Text Key="Welcome.PromiseReview" />
            </x:Array>
          </ItemsControl.ItemsSource>
        </ItemsControl>
        <Button x:Name="WelcomeScan" Content="{views:Text Welcome.Scan}" Command="{Binding ScanCommand}"
                Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left" Padding="20,8" IsDefault="True" />
      </StackPanel>
    </ScrollViewer>

    <!-- Scanning and stopping -->
    <StackPanel Grid.Row="1" MaxWidth="720" HorizontalAlignment="Left"
                Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding BusyText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"
                 AutomationProperties.HeadingLevel="Level2" />
      <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16" AutomationProperties.Name="{Binding BusyText}" />
      <TextBlock Text="{views:Text Scan.ListIntro}" TextWrapping="Wrap" Margin="0,0,0,6" />
      <ItemsControl Focusable="False" Margin="0,0,0,20" ItemTemplate="{StaticResource NoteTemplate}">
        <ItemsControl.ItemsSource>
          <x:Array Type="{x:Type sys:String}">
            <views:Text Key="Scan.ItemSystem" />
            <views:Text Key="Scan.ItemAdapters" />
            <views:Text Key="Scan.ItemDrivers" />
            <views:Text Key="Scan.ItemDisplays" />
          </x:Array>
        </ItemsControl.ItemsSource>
      </ItemsControl>
      <Button x:Name="CancelButton" Content="{views:Text Scan.Cancel}" Command="{Binding CancelCommand}"
              HorizontalAlignment="Left" Padding="20,8" IsCancel="True" />
    </StackPanel>

    <!-- Result -->
    <DockPanel Grid.Row="1" Visibility="{Binding IsResult, Converter={StaticResource Visible}}">
      <StackPanel DockPanel.Dock="Top" DataContext="{Binding Result}" Margin="0,0,0,12">
        <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level2" />
        <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource FactTemplate}"
                      Focusable="False" Margin="0,8,0,0" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="ResultScan" Content="{views:Text Result.ScanAgain}" Command="{Binding ScanCommand}" Padding="20,8" />
      </StackPanel>
      <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" Focusable="True"
                    AutomationProperties.Name="{views:Text Result.CardsName}">
        <ItemsControl ItemsSource="{Binding Result.Cards}" ItemTemplate="{StaticResource CardTemplate}"
                      Focusable="False" Margin="0,0,8,0" />
      </ScrollViewer>
    </DockPanel>

    <!-- Stopped -->
    <StackPanel Grid.Row="1" MaxWidth="720" HorizontalAlignment="Left"
                Visibility="{Binding IsStopped, Converter={StaticResource Visible}}">
      <TextBlock Text="{views:Text Stopped.Message}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20"
                 AutomationProperties.HeadingLevel="Level2" />
      <Button x:Name="StoppedScan" Content="{views:Text Result.ScanAgain}" Command="{Binding ScanCommand}"
              HorizontalAlignment="Left" Padding="20,8" />
    </StackPanel>

    <!-- Restart required -->
    <StackPanel Grid.Row="1" MaxWidth="720" HorizontalAlignment="Left"
                Visibility="{Binding NeedsRestart, Converter={StaticResource Visible}}">
      <DockPanel Margin="0,0,0,20">
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,3,8,0" />
        <TextBlock Text="{views:Text Restart.Message}" FontSize="16" TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level2" />
      </DockPanel>
      <Button x:Name="RestartClose" Content="{views:Text Restart.Close}" Click="OnCloseClick"
              HorizontalAlignment="Left" Padding="20,8" />
    </StackPanel>
  </Grid>
</Window>
