<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/WinGPUDoctor.Cli/CollectionOutput.cs" Link="Cli/CollectionOutput.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1"><PrivateAssets>all</PrivateAssets></PackageReference>
    <ProjectReference Include="../../src/WinGPUDoctor.Protocol/WinGPUDoctor.Protocol.csproj" />
    <ProjectReference Include="../../src/WinGPUDoctor.Supervisor/WinGPUDoctor.Supervisor.csproj" />
    <ProjectReference Include="../../src/WinGPUDoctor.Windows/WinGPUDoctor.Windows.csproj" />
    <ProjectReference Include="../../src/WinGPUDoctor.Worker/WinGPUDoctor.Worker.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <WorkerOutputDirectory>$(MSBuildThisFileDirectory)..\..\src\WinGPUDoctor.Worker\bin\$(Configuration)\net10.0-windows</WorkerOutputDirectory>
  </PropertyGroup>
  <Target Name="CopyWorkerDeployment" AfterTargets="Build">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\copy-worker-deployment.ps1&quot; -WorkerOutput &quot;$(WorkerOutputDirectory)&quot; -Destination &quot;$(OutDir)worker&quot;" />
  </Target>
</Project>
