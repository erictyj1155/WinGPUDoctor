{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WinGPUDoctor diagnostic report 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolVersion", "collectedOnUtc", "facts", "findings", "warnings", "collection", "privacy"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "toolVersion": {"type": "string", "maxLength": 40},
    "collectedOnUtc": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "facts": {"$ref": "#/$defs/facts"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"enum": ["inventoryOnly", "providerReportedValues", "topologyNotCollected", "reviewBeforeSharing", "collectionIncomplete", "valuesRedacted"]}},
    "collection": {"type": "array", "items": {"$ref": "#/$defs/collector"}},
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyVersion", "redactedFields"],
      "properties": {"policyVersion": {"const": "0.1"}, "redactedFields": {"type": "integer", "minimum": 0}}
    }
  },
  "$defs": {
    "source": {"enum": ["wmiOperatingSystem", "wmiComputerSystem", "wmiVideoController", "wmiSignedDriver", "displayConfig", "notCollected"]},
    "reason": {"enum": ["none", "missingValue", "notImplemented", "nonPciDevice", "invalidValue", "noMatchingDriver", "ambiguousDriver", "accessDenied", "providerUnavailable", "timeout", "queryFailed", "sensitiveValue"]},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "value", "source", "reason"],
      "properties": {
        "state": {"enum": ["available", "unknown", "unsupported", "failed", "redacted"]},
        "value": {}, "source": {"$ref": "#/$defs/source"}, "reason": {"$ref": "#/$defs/reason"}
      },
      "if": {"properties": {"state": {"const": "available"}}},
      "then": {"properties": {"value": {"not": {"type": "null"}}, "reason": {"const": "none"}}},
      "else": {"properties": {"value": {"type": "null"}, "reason": {"not": {"const": "none"}}}}
    },
    "text": {
      "allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"value": {"type": ["string", "null"], "minLength": 1, "maxLength": 160}}}]
    },
    "facts": {
      "type": "object", "additionalProperties": false, "required": ["system", "gpus", "displays"],
      "properties": {
        "system": {
          "type": "object", "additionalProperties": false,
          "required": ["windowsVersion", "windowsBuild", "manufacturer", "model"],
          "properties": {
            "windowsVersion": {"$ref": "#/$defs/text"}, "windowsBuild": {"$ref": "#/$defs/text"},
            "manufacturer": {"$ref": "#/$defs/text"}, "model": {"$ref": "#/$defs/text"}
          }
        },
        "gpus": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"value": {"type": ["array", "null"], "maxItems": 128, "items": {"$ref": "#/$defs/gpu"}}}}]},
        "displays": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"value": {"type": ["array", "null"], "items": {"$ref": "#/$defs/display"}}}}]}
      }
    },
    "gpu": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "pciVendorId", "pciDeviceId", "classification", "driver"],
      "properties": {
        "id": {"type": "string", "pattern": "^gpu-[1-9][0-9]*$"},
        "name": {"$ref": "#/$defs/text"}, "pciVendorId": {"$ref": "#/$defs/text"},
        "pciDeviceId": {"$ref": "#/$defs/text"}, "classification": {"$ref": "#/$defs/text"},
        "driver": {
          "type": "object", "additionalProperties": false, "required": ["provider", "version", "date"],
          "properties": {"provider": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "date": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "display": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "adapterId", "mode"],
      "properties": {
        "id": {"type": "string", "pattern": "^display-[1-9][0-9]*$"},
        "name": {"$ref": "#/$defs/text"}, "adapterId": {"$ref": "#/$defs/text"},
        "mode": {"allOf": [{"$ref": "#/$defs/observation"}, {"properties": {"value": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/mode"}]}}}]}
      }
    },
    "mode": {
      "type": "object", "additionalProperties": false,
      "required": ["widthPixels", "heightPixels", "refreshNumerator", "refreshDenominator"],
      "properties": {
        "widthPixels": {"type": "integer", "minimum": 1}, "heightPixels": {"type": "integer", "minimum": 1},
        "refreshNumerator": {"type": "integer", "minimum": 1}, "refreshDenominator": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "message", "evidence"],
      "properties": {
        "id": {"type": "string"}, "severity": {"enum": ["information", "warning", "error"]}, "message": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^facts\\."}}
      }
    },
    "collector": {
      "type": "object", "additionalProperties": false, "required": ["source", "status", "reason"],
      "properties": {
        "source": {"$ref": "#/$defs/source"}, "status": {"enum": ["succeeded", "partial", "failed", "unsupported"]},
        "reason": {"$ref": "#/$defs/reason"}
      }
    }
  }
}
